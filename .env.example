# Safe local default. Live mode fails closed without non-default secrets.
REMEDIATION_APP_MODE=simulation
REMEDIATION_DATABASE_PATH=data/orchestrator.db
REMEDIATION_GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
REMEDIATION_CONTROL_PLANE_USERNAME=operator
REMEDIATION_CONTROL_PLANE_PASSWORD=replace-with-another-openssl-rand-hex-32
REMEDIATION_DEVIN_API_KEY=
REMEDIATION_DEVIN_ORG_ID=org-replace-me
REMEDIATION_DEVIN_MAX_ACU_LIMIT=3
REMEDIATION_DEVIN_BYPASS_APPROVAL=false
REMEDIATION_USAGE_MODEL=self_serve
REMEDIATION_POLL_INTERVAL_SECONDS=2
REMEDIATION_WORKER_STALE_AFTER_SECONDS=60
REMEDIATION_MAX_ACTIVE_SESSIONS=3
REMEDIATION_CREATE_RETRY_INTERVAL_SECONDS=60

# The live allowlist is intentionally pinned to the challenge fork and owner.
REMEDIATION_GITHUB_REPOSITORY=samuelczhao/superset
REMEDIATION_GITHUB_REPOSITORY_ID=1340946845
REMEDIATION_GITHUB_DEFAULT_BRANCH=master
REMEDIATION_GITHUB_ALLOWED_ACTOR=samuelczhao
REMEDIATION_GITHUB_ALLOWED_ACTOR_ID=30126000
REMEDIATION_TRIGGER_LABEL=devin:ready
REMEDIATION_MAX_WEBHOOK_BYTES=1000000
