# Safe local default. Live mode fails closed without non-default secrets.
APP_MODE=simulation
DATABASE_PATH=data/orchestrator.db
GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
CONTROL_PLANE_USERNAME=operator
CONTROL_PLANE_PASSWORD=replace-with-another-openssl-rand-hex-32
DEVIN_API_KEY=
DEVIN_ORG_ID=org-replace-me
DEVIN_MAX_ACU_LIMIT=3
DEVIN_BYPASS_APPROVAL=false
POLL_INTERVAL_SECONDS=2
WORKER_STALE_AFTER_SECONDS=60
MAX_ACTIVE_SESSIONS=3
CREATE_RETRY_INTERVAL_SECONDS=60

# The live allowlist is intentionally pinned to the challenge fork and owner.
GITHUB_REPOSITORY=samuelczhao/superset
GITHUB_REPOSITORY_ID=1340946845
GITHUB_DEFAULT_BRANCH=master
GITHUB_ALLOWED_ACTOR=samuelczhao
GITHUB_ALLOWED_ACTOR_ID=30126000
TRIGGER_LABEL=devin:ready
MAX_WEBHOOK_BYTES=1000000
